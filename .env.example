# Copy to .env and adjust. Never commit .env.
DB_PATH=data/dns-geo-check.db

# Per-IP cap on POST /check, enforced over the trailing window below.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# The deployed Cloudflare Worker and the shared secret it checks
# (X-Probe-Secret). Set PROBE_SECRET to the same value you pass to
# `wrangler secret put PROBE_SECRET`. /check returns 503 until both are set.
WORKER_URL=
PROBE_SECRET=

# Outer timeout (seconds) on the Worker's aggregated response.
REQUEST_TIMEOUT_SECONDS=20.0

# Optional: where GET / sends a browser (this is a JSON API with no UI).
# Blank -> GET / returns a small JSON pointer to the API.
INDEX_REDIRECT_URL=

# App log verbosity (debug | info | warning | error).
LOG_LEVEL=info
